    { "term": "Pivot", "strict": true, "note": "Feature: head rotation tuning. 'pivot' as an ordinary word may be translated." },
    { "term": "Quadviews", "strict": true, "note": "Feature: dynamic foveated rendering." },
    { "term": "Frame Generation", "strict": true, "note": "Feature: generated frames. Keep both words, capitalised." },
    { "term": "Position Assist", "strict": true, "note": "Pivot feature." },
    { "term": "Depth Lock", "strict": true, "note": "Depth feature." },
    { "term": "Interpolate", "strict": false, "note": "Frame Generation mode name; keep where it names the mode." },
    { "term": "Extrapolate", "strict": false, "note": "Frame Generation mode name; keep where it names the mode." },
    { "term": "Sequenced", "strict": false, "note": "Turbo strategy name; keep where it names the strategy." },
    { "term": "OSD", "strict": false, "note": "On-screen display. The abbreviation may stay, the long form is translated." },
    { "term": "SteamVR", "strict": true, "note": "Third-party runtime." },
    { "term": "Steam", "strict": false, "note": "Third-party store." },
