{
  "_about": "Names every VectorXR translation keeps in English. 'strict' terms are checked by tests/i18n.test.mjs: when the English message contains the term, the translation must contain it unchanged. Other terms are guidance: keep them unless the language has a settled form.",
  "terms": [
    { "term": "VectorXR", "strict": true, "note": "Product name." },
    { "term": "OpenXR", "strict": true, "note": "Khronos standard; also 'OpenXR layer', 'OpenXR runtime' (translate 'layer' and 'runtime')." },
