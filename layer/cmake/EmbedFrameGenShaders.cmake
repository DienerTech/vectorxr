# Writes framegen_shaders.cpp from compiled shader binaries.
# Inputs: OUTPUT, PASSES and DRAW (comma lists), DXBC_DIR, SPIRV_DIR (empty
# without SPIR-V). DRAW shaders are DXBC only.
string(REPLACE "," ";" PASSES "${PASSES}")
string(REPLACE "," ";" DRAW "${DRAW}")
set(_content "// Generated by layer/cmake/EmbedFrameGenShaders.cmake. Do not edit.\n#include \"depthxr/framegen_gpu.h\"\n\nnamespace depthxr::framegen_shaders {\nnamespace {\n")
set(_dxbc_list "")
set(_spirv_list "")
foreach(_pass IN LISTS PASSES)
    foreach(_kind IN ITEMS dxbc spirv)
        if(_kind STREQUAL "dxbc")
            set(_file "${DXBC_DIR}/${_pass}.dxbc")
        else()
            set(_file "${SPIRV_DIR}/${_pass}.spv")
        endif()
        set(_name "k${_kind}_${_pass}")
        if(EXISTS "${_file}" AND NOT (_kind STREQUAL "spirv" AND SPIRV_DIR STREQUAL ""))
            file(READ "${_file}" _hex HEX)
            string(LENGTH "${_hex}" _hex_length)
            math(EXPR _size "${_hex_length} / 2")
            string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
            string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n    " _bytes "${_bytes}")
            string(APPEND _content "alignas(4) const unsigned char ${_name}[] = {\n    ${_bytes}\n};\n")
            if(_kind STREQUAL "dxbc")
                string(APPEND _dxbc_list "    Blob{${_name}, ${_size}},\n")
            else()
                string(APPEND _spirv_list "    Blob{${_name}, ${_size}},\n")
            endif()
        else()
            if(_kind STREQUAL "dxbc")
                message(FATAL_ERROR "Missing Frame Generation DXBC: ${_file}")
            endif()
            string(APPEND _spirv_list "    Blob{nullptr, 0},\n")
        endif()
    endforeach()
endforeach()
set(_draw_list "")
foreach(_shader IN LISTS DRAW)
    set(_file "${DXBC_DIR}/${_shader}.dxbc")
    if(NOT EXISTS "${_file}")
        message(FATAL_ERROR "Missing Frame Generation DXBC: ${_file}")
    endif()
    file(READ "${_file}" _hex HEX)
    string(LENGTH "${_hex}" _hex_length)
    math(EXPR _size "${_hex_length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n    " _bytes "${_bytes}")
    string(APPEND _content "alignas(4) const unsigned char kdxbc_${_shader}[] = {\n    ${_bytes}\n};\n")
    string(APPEND _draw_list "    Blob{kdxbc_${_shader}, ${_size}},\n")
endforeach()
string(APPEND _content "} // namespace\n\nconst std::array<Blob, kFrameGenPassCount> kDxbc{{\n${_dxbc_list}}};\nconst std::array<Blob, kFrameGenPassCount> kSpirv{{\n${_spirv_list}}};\nconst std::array<Blob, kDrawShaderCount> kDxbcDraw{{\n${_draw_list}}};\n\n} // namespace depthxr::framegen_shaders\n")
file(WRITE "${OUTPUT}.tmp" "${_content}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
